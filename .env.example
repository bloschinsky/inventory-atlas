# Copy this file to .env before running `docker compose up --build`.
# Never commit the resulting .env file. Values marked "database authority after
# bootstrap" seed app_settings once; later environment changes do not overwrite it.

# Deployment metadata and published HTTP port.
APP_VERSION=0.1.0-dev.1
VCS_REF=unknown
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DEV_PORT=5432

# PostgreSQL stays on the private Compose network. Replace both example secrets.
POSTGRES_DB=inventory_atlas
POSTGRES_USER=inventory_atlas
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Runtime mode and canonical URL (APP_BASE_URL: database authority after bootstrap).
NODE_ENV=production
APP_BASE_URL=http://localhost
DATABASE_URL=postgresql://inventory_atlas:replace-with-a-long-random-database-password@db:5432/inventory_atlas
KYSELY_DATABASE_URL=postgresql://inventory_atlas:replace-with-a-long-random-database-password@db:5432/inventory_atlas

# Authentication and reverse-proxy policy.
SESSION_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SECURE=false
TRUST_PROXY=true

# Mutable installation settings seeded once (database authority after bootstrap).
DEFAULT_LOCALE=en
PUBLIC_CATALOG_MODE=authenticated

# Infrastructure-only media settings; app_settings must never shadow these values.
MEDIA_DRIVER=local
MEDIA_LOCAL_PATH=/var/lib/inventory-atlas/media
MEDIA_MAX_UPLOAD_BYTES=26214400
MEDIA_MAX_PIXELS=40000000
MEDIA_CHILD_RSS_MB=512
MEDIA_CHILD_TIMEOUT_MS=30000

# Reserved for the optional S3 adapter delivered with media support. The compact
# FND-02 environment currently requires MEDIA_DRIVER=local.
S3_ENDPOINT=https://s3.example.invalid
S3_BUCKET=inventory-atlas
S3_REGION=us-east-1
S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key_id
S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key

# Protected restore controls; leave disabled except for an intentional restore command.
ALLOW_RESTORE=no
RESTORE_FILE=

# Compact mode claims jobs in the API. Expanded mode changes this to worker.
JOB_RUNNER_MODE=compact
PRISMA_POOL_MAX=6
KYSELY_POOL_MAX=6

# Structured logging threshold.
LOG_LEVEL=info
