{
  "$schema": "https://inventory-atlas.local/fixtures/catalog-1.json",
  "fixtureVersion": "1.1.0",
  "description": "Representative bilingual catalog and typed-field fixtures for CAT-01 and CAT-02. English is the source locale; Ukrainian is complete for every user-facing label. Stable keys never change when labels change. Every field vocabulary term matches approved blueprint section 8.5: the twelve approved data types, three-value visibility, a plain-text unit, one optional category applicability, and displayOrder for ordering (position is reserved for attribute-value multiplicity).",
  "locales": ["en", "uk"],
  "categories": [
    {
      "key": "electronics",
      "displayOrder": 1,
      "labels": { "en": "Electronics", "uk": "Електроніка" },
      "placeholderMediaKey": "category.electronics"
    },
    {
      "key": "books",
      "displayOrder": 2,
      "labels": { "en": "Books", "uk": "Книги" },
      "placeholderMediaKey": "category.books"
    },
    {
      "key": "tools",
      "displayOrder": 3,
      "labels": { "en": "Tools", "uk": "Інструменти" },
      "placeholderMediaKey": "category.tools"
    },
    {
      "key": "documents",
      "displayOrder": 4,
      "labels": { "en": "Documents", "uk": "Документи" },
      "placeholderMediaKey": "category.documents",
      "archived": true,
      "archivedNote": "Archived entry retained so historical Items still resolve, per CAT-01 acceptance criteria."
    }
  ],
  "lifecycleStatusNote": "The approved stable keys seeded by db:seed. Labels, color tokens and ordering match packages/backend/src/seed.ts so the fixture and the seed cannot drift.",
  "lifecycleStatuses": [
    {
      "key": "stored",
      "displayOrder": 10,
      "colorToken": "status.neutral",
      "labels": { "en": "Stored", "uk": "На зберіганні" }
    },
    {
      "key": "reserved",
      "displayOrder": 20,
      "colorToken": "status.info",
      "labels": { "en": "Reserved", "uk": "Зарезервовано" }
    },
    {
      "key": "lent",
      "displayOrder": 30,
      "colorToken": "status.warning",
      "labels": { "en": "Lent", "uk": "Позичено" }
    },
    {
      "key": "for_sale",
      "displayOrder": 40,
      "colorToken": "status.info",
      "labels": { "en": "For sale", "uk": "На продаж" }
    },
    {
      "key": "sold",
      "displayOrder": 50,
      "colorToken": "status.success",
      "labels": { "en": "Sold", "uk": "Продано" }
    },
    {
      "key": "lost",
      "displayOrder": 60,
      "colorToken": "status.danger",
      "labels": { "en": "Lost", "uk": "Втрачено" }
    },
    {
      "key": "archived",
      "displayOrder": 70,
      "colorToken": "status.muted",
      "labels": { "en": "Archived", "uk": "Архівовано" }
    }
  ],
  "fieldDefinitions": [
    {
      "key": "serial_number",
      "scope": "item",
      "type": "text",
      "displayOrder": 1,
      "labels": { "en": "Serial number", "uk": "Серійний номер" },
      "appliesToCategory": "electronics",
      "required": false,
      "repeatable": false,
      "flags": { "searchable": true, "filterable": true, "sortable": false },
      "visibility": "authenticated"
    },
    {
      "key": "author",
      "scope": "item",
      "type": "text",
      "displayOrder": 2,
      "labels": { "en": "Author", "uk": "Автор" },
      "appliesToCategory": "books",
      "required": false,
      "repeatable": true,
      "flags": { "searchable": true, "filterable": true, "sortable": true },
      "visibility": "public"
    },
    {
      "key": "quantity",
      "scope": "item",
      "type": "number",
      "displayOrder": 3,
      "labels": { "en": "Quantity", "uk": "Кількість" },
      "required": true,
      "repeatable": false,
      "validation": { "min": 0, "max": 100000, "integer": true },
      "flags": { "searchable": false, "filterable": true, "sortable": true },
      "visibility": "public"
    },
    {
      "key": "weight",
      "scope": "item",
      "type": "number",
      "displayOrder": 4,
      "labels": { "en": "Weight", "uk": "Вага" },
      "unit": "kg",
      "required": false,
      "repeatable": false,
      "validation": { "min": 0 },
      "flags": { "searchable": false, "filterable": true, "sortable": true },
      "visibility": "public"
    },
    {
      "key": "purchase_price",
      "scope": "item",
      "type": "money",
      "displayOrder": 5,
      "labels": { "en": "Purchase price", "uk": "Ціна придбання" },
      "required": false,
      "repeatable": false,
      "flags": { "searchable": false, "filterable": true, "sortable": true },
      "visibility": "authenticated"
    },
    {
      "key": "purchased_at",
      "scope": "item",
      "type": "date",
      "displayOrder": 6,
      "labels": { "en": "Purchased on", "uk": "Дата придбання" },
      "required": false,
      "repeatable": false,
      "flags": { "searchable": false, "filterable": true, "sortable": true },
      "visibility": "authenticated"
    },
    {
      "key": "is_fragile",
      "scope": "item",
      "type": "boolean",
      "displayOrder": 7,
      "labels": { "en": "Fragile", "uk": "Крихке" },
      "required": false,
      "repeatable": false,
      "flags": { "searchable": false, "filterable": true, "sortable": false },
      "visibility": "public"
    },
    {
      "key": "condition",
      "scope": "item",
      "type": "select",
      "displayOrder": 8,
      "labels": { "en": "Condition", "uk": "Стан" },
      "required": false,
      "repeatable": false,
      "flags": { "searchable": true, "filterable": true, "sortable": false },
      "visibility": "public",
      "options": [
        { "key": "new", "displayOrder": 1, "labels": { "en": "New", "uk": "Новий" } },
        { "key": "used", "displayOrder": 2, "labels": { "en": "Used", "uk": "Вживаний" } },
        {
          "key": "broken",
          "displayOrder": 3,
          "labels": { "en": "Broken", "uk": "Несправний" },
          "archived": true
        }
      ]
    },
    {
      "key": "materials",
      "scope": "item",
      "type": "multiselect",
      "displayOrder": 9,
      "labels": { "en": "Materials", "uk": "Матеріали" },
      "required": false,
      "repeatable": false,
      "flags": { "searchable": true, "filterable": true, "sortable": false },
      "visibility": "public",
      "options": [
        { "key": "metal", "displayOrder": 1, "labels": { "en": "Metal", "uk": "Метал" } },
        { "key": "plastic", "displayOrder": 2, "labels": { "en": "Plastic", "uk": "Пластик" } },
        { "key": "wood", "displayOrder": 3, "labels": { "en": "Wood", "uk": "Дерево" } }
      ],
      "note": "multiselect and select reject repeatable = true (CAT-02). Persisted as ordered scalar value_option_id rows only, never a UUID array."
    },
    {
      "key": "shelf_capacity",
      "scope": "storage_node",
      "type": "number",
      "displayOrder": 1,
      "labels": { "en": "Shelf capacity", "uk": "Місткість полиці" },
      "required": false,
      "repeatable": false,
      "validation": { "min": 0, "integer": true },
      "flags": { "searchable": false, "filterable": true, "sortable": true },
      "visibility": "authenticated"
    }
  ],
  "sampleItems": [
    {
      "publicIdPlaceholder": "item-router",
      "category": "electronics",
      "lifecycleStatus": "stored",
      "core": { "title": { "en": "Wi-Fi router", "uk": "Wi-Fi роутер" } },
      "attributes": {
        "serial_number": "SN-000-DEMO",
        "quantity": 1,
        "is_fragile": true,
        "condition": "used",
        "materials": ["metal", "plastic"]
      },
      "tags": ["network", "home-lab"]
    },
    {
      "publicIdPlaceholder": "item-novel",
      "category": "books",
      "lifecycleStatus": "lent",
      "core": { "title": { "en": "Kobzar", "uk": "Кобзар" } },
      "attributes": {
        "author": ["Taras Shevchenko"],
        "quantity": 3,
        "condition": "new",
        "materials": ["wood"]
      },
      "tags": ["classics", "ukrainian-literature"]
    }
  ]
}
