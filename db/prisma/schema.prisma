generator client {
  provider            = "prisma-client"
  output              = "../../packages/backend/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  settingKey String   @id @map("setting_key") @db.VarChar(64)
  valueText  String   @map("value_text")
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model InstallationMetadata {
  singleton             Boolean  @id
  settingsInitializedAt DateTime @map("settings_initialized_at") @db.Timestamptz(6)

  @@map("installation_metadata")
}

/// Database check constraints defined by the Kysely migration remain authoritative.
model User {
  id                  String              @id @db.Uuid
  emailNormalized     String              @unique @map("email_normalized")
  displayName         String              @map("display_name")
  passwordHash        String              @map("password_hash")
  role                String
  locale              String              @default("en")
  status              String              @default("active")
  lastLoginAt         DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime?           @map("archived_at") @db.Timestamptz(6)
  version             BigInt              @default(1)
  auditEvents         AuditEvent[]
  idempotencyRecords  IdempotencyRecord[] @ignore
  invitationsAccepted Invitation[]        @relation("InvitationAcceptor")
  invitationsIssued   Invitation[]        @relation("InvitationInviter")
  movements           Movement[]          @ignore
  sessions            Session[]
  uploadSessions      UploadSession[]

  @@index([role], map: "users_active_role_idx", where: raw("((status = 'active'::text) AND (archived_at IS NULL))"))
  @@map("users")
}

/// Database check constraints defined by the Kysely migration remain authoritative.
model Session {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  csrfSecretHash    String    @map("csrf_secret_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipHash            String?   @map("ip_hash")
  userAgentSummary  String?   @map("user_agent_summary") @db.VarChar(256)
  user              User      @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([idleExpiresAt], where: raw("(revoked_at IS NULL)"))
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Database check constraints defined by the Kysely migration remain authoritative.
model Invitation {
  id              String    @id @db.Uuid
  emailNormalized String    @map("email_normalized")
  role            String
  tokenHash       String    @unique @map("token_hash")
  inviterId       String    @map("inviter_id") @db.Uuid
  acceptedById    String?   @map("accepted_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  version         BigInt    @default(1)
  acceptedBy      User?     @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inviter         User      @relation("InvitationInviter", fields: [inviterId], references: [id], onUpdate: NoAction)

  @@index([emailNormalized])
  @@index([inviterId])
  @@index([acceptedById])
  @@index([expiresAt], map: "invitations_pending_expiry_idx", where: raw("((accepted_at IS NULL) AND (revoked_at IS NULL))"))
  @@map("invitations")
}

/// Database check constraints and the append-only trigger defined by Kysely remain authoritative.
model AuditEvent {
  id               String   @id @db.Uuid
  actorId          String?  @map("actor_id") @db.Uuid
  action           String   @db.VarChar(96)
  entityType       String   @map("entity_type") @db.VarChar(64)
  entityId         String?  @map("entity_id") @db.Uuid
  correlationId    String   @map("correlation_id") @db.VarChar(128)
  requestId        String   @map("request_id") @db.VarChar(128)
  beforeJson       Json?    @map("before_json")
  afterJson        Json?    @map("after_json")
  ipHash           String?  @map("ip_hash")
  userAgentSummary String?  @map("user_agent_summary") @db.VarChar(256)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor            User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([createdAt, id], map: "audit_events_created_at_idx")
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt], map: "audit_events_entity_idx")
  @@index([correlationId])
  @@index([requestId])
  @@map("audit_events")
}

/// Database label, ordering, archive, version and immutable-key checks remain authoritative.
model Category {
  id               String            @id @db.Uuid
  parentId         String?           @map("parent_id") @db.Uuid
  key              String            @unique @db.VarChar(64)
  labelI18n        Json              @map("label_i18n")
  displayTemplate  String?           @map("display_template")
  displayOrder     Int               @default(0) @map("display_order")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(6)
  version          BigInt            @default(1)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children         Category[]        @relation("CategoryTree")
  fieldDefinitions FieldDefinition[]
  itemSearch       ItemSearch[]      @ignore
  items            Item[]

  @@index([parentId, displayOrder, key], map: "categories_parent_order_idx")
  @@index([displayOrder, key], map: "categories_active_order_idx", where: raw("(archived_at IS NULL)"))
  @@map("categories")
}

/// Database label, ordering, archive, version and immutable-key checks remain authoritative.
model LifecycleStatus {
  id           String       @id @db.Uuid
  key          String       @unique @db.VarChar(64)
  labelI18n    Json         @map("label_i18n")
  colorToken   String       @map("color_token") @db.VarChar(64)
  displayOrder Int          @default(0) @map("display_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime?    @map("archived_at") @db.Timestamptz(6)
  version      BigInt       @default(1)
  itemSearch   ItemSearch[] @ignore
  items        Item[]

  @@index([displayOrder, key], map: "lifecycle_statuses_active_order_idx", where: raw("(archived_at IS NULL)"))
  @@map("lifecycle_statuses")
}

/// Kysely owns reads and dispatch. Source transactions may insert only through OutboxPort.
model Outbox {
  id               String    @id @db.Uuid
  topic            String    @db.VarChar(96)
  aggregateType    String    @map("aggregate_type") @db.VarChar(64)
  aggregateId      String    @map("aggregate_id") @db.Uuid
  payloadJson      Json      @map("payload_json")
  deduplicationKey String    @unique @map("deduplication_key") @db.VarChar(192)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  attempt          Int       @default(0)
  availableAt      DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(96)
  lastErrorMessage String?   @map("last_error_message") @db.VarChar(512)

  @@index([availableAt, createdAt, id], map: "outbox_pending_idx", where: raw("(published_at IS NULL)"))
  @@index([aggregateType, aggregateId, createdAt], map: "outbox_aggregate_idx")
  @@map("outbox")
  @@ignore
}

/// Kysely owns the job queue. No Prisma transaction may claim, lease or complete a job; the
/// model exists so the committed schema stays a complete description of the database.
model Job {
  id               String    @id @db.Uuid
  type             String    @db.VarChar(96)
  payloadJson      Json      @map("payload_json")
  payloadVersion   Int       @default(1) @map("payload_version")
  state            String    @default("queued") @db.VarChar(16)
  priority         Int       @default(100)
  attempt          Int       @default(0)
  maxAttempts      Int       @default(5) @map("max_attempts")
  availableAt      DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leasedUntil      DateTime? @map("leased_until") @db.Timestamptz(6)
  heartbeatAt      DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  workerId         String?   @map("worker_id") @db.VarChar(128)
  idempotencyKey   String    @unique @map("idempotency_key") @db.VarChar(192)
  progressJson     Json      @default("{}") @map("progress_json")
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(96)
  lastErrorMessage String?   @map("last_error_message") @db.VarChar(512)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([type, priority, availableAt, createdAt], map: "jobs_claim_idx", where: raw("((state)::text = ANY ((ARRAY['queued'::character varying, 'retry_wait'::character varying])::text[]))"))
  @@index([completedAt(sort: Desc)], map: "jobs_dead_idx", where: raw("((state)::text = 'dead'::text)"))
  @@index([leasedUntil], map: "jobs_lease_idx", where: raw("((state)::text = 'running'::text)"))
  @@index([type, state])
  @@map("jobs")
  @@ignore
}

/// Database check constraints, partial unique keys and the immutable key/scope trigger defined
/// by the Kysely migration remain authoritative.
model AttributeValue {
  id                   String          @id @db.Uuid
  fieldDefinitionId    String          @map("field_definition_id") @db.Uuid
  itemId               String?         @map("item_id") @db.Uuid
  storageNodeId        String?         @map("storage_node_id") @db.Uuid
  position             Int
  valueText            String?         @map("value_text")
  valueNumber          Decimal?        @map("value_number") @db.Decimal(30, 10)
  valueBoolean         Boolean?        @map("value_boolean")
  valueDate            DateTime?       @map("value_date") @db.Date
  valueDatetime        DateTime?       @map("value_datetime") @db.Timestamptz(6)
  valueOptionId        String?         @map("value_option_id") @db.Uuid
  valueMoneyAmount     Decimal?        @map("value_money_amount") @db.Decimal(20, 4)
  valueMoneyCurrency   String?         @map("value_money_currency") @db.Char(3)
  valueReferenceItemId String?         @map("value_reference_item_id") @db.Uuid
  valueReferenceNodeId String?         @map("value_reference_node_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  definition           FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onUpdate: NoAction)
  item                 Item?           @relation("ItemAttributeValues", fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attribute_values_item_fk")
  option               FieldOption?    @relation(fields: [valueOptionId, fieldDefinitionId], references: [id, fieldDefinitionId], onUpdate: NoAction, map: "attribute_values_option_fk")
  referencedItem       Item?           @relation("ReferencedItemAttributeValues", fields: [valueReferenceItemId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "attribute_values_reference_item_fk")

  @@unique([itemId, fieldDefinitionId, valueOptionId], map: "attribute_values_item_option_idx", where: raw("((item_id IS NOT NULL) AND (value_option_id IS NOT NULL))"))
  @@unique([itemId, fieldDefinitionId, position], map: "attribute_values_item_position_idx", where: raw("(item_id IS NOT NULL)"))
  @@unique([storageNodeId, fieldDefinitionId, valueOptionId], map: "attribute_values_node_option_idx", where: raw("((storage_node_id IS NOT NULL) AND (value_option_id IS NOT NULL))"))
  @@unique([storageNodeId, fieldDefinitionId, position], map: "attribute_values_node_position_idx", where: raw("(storage_node_id IS NOT NULL)"))
  @@index([fieldDefinitionId, position], map: "attribute_values_definition_idx")
  @@index([valueOptionId], map: "attribute_values_option_idx", where: raw("(value_option_id IS NOT NULL)"))
  @@index([valueReferenceItemId], map: "attribute_values_reference_item_idx", where: raw("(value_reference_item_id IS NOT NULL)"))
  @@index([valueReferenceNodeId], map: "attribute_values_reference_node_idx", where: raw("(value_reference_node_id IS NOT NULL)"))
  @@map("attribute_values")
}

/// Database check constraints, partial unique keys and the immutable key/scope trigger defined
/// by the Kysely migration remain authoritative.
model FieldDefinition {
  id               String           @id @db.Uuid
  key              String           @db.VarChar(64)
  scope            String           @db.VarChar(16)
  categoryId       String?          @map("category_id") @db.Uuid
  labelI18n        Json             @map("label_i18n")
  helpI18n         Json?            @map("help_i18n")
  dataType         String           @map("data_type") @db.VarChar(16)
  required         Boolean          @default(false)
  repeatable       Boolean          @default(false)
  searchable       Boolean          @default(false)
  filterable       Boolean          @default(false)
  sortable         Boolean          @default(false)
  visibility       String           @default("authenticated") @db.VarChar(16)
  unit             String?          @db.VarChar(32)
  defaultValueJson Json?            @map("default_value_json")
  validationJson   Json             @default("{}") @map("validation_json")
  displayOrder     Int              @default(0) @map("display_order")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(6)
  version          BigInt           @default(1)
  attributeValues  AttributeValue[]
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  options          FieldOption[]

  @@unique([scope, categoryId, key], map: "field_definitions_category_key_idx", where: raw("((archived_at IS NULL) AND (category_id IS NOT NULL))"))
  @@unique([scope, key], map: "field_definitions_scope_key_idx", where: raw("((archived_at IS NULL) AND (category_id IS NULL))"))
  @@index([categoryId], map: "field_definitions_category_idx")
  @@index([scope, categoryId, displayOrder, key], map: "field_definitions_scope_order_idx", where: raw("(archived_at IS NULL)"))
  @@map("field_definitions")
}

/// Database check constraints, the active-key partial unique index and the immutable
/// key/owner trigger defined by the Kysely migration remain authoritative.
model FieldOption {
  id                String           @id @db.Uuid
  fieldDefinitionId String           @map("field_definition_id") @db.Uuid
  key               String           @db.VarChar(64)
  labelI18n         Json             @map("label_i18n")
  displayOrder      Int              @default(0) @map("display_order")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)
  attributeValues   AttributeValue[]
  definition        FieldDefinition  @relation(fields: [fieldDefinitionId], references: [id], onUpdate: NoAction)

  @@unique([fieldDefinitionId, key], map: "field_options_active_key_idx", where: raw("(archived_at IS NULL)"))
  @@unique([id, fieldDefinitionId], map: "field_options_identity_key")
  @@index([fieldDefinitionId, displayOrder, key], map: "field_options_order_idx")
  @@map("field_options")
}

/// Database checks and the immutable-public-ID trigger defined by Kysely remain authoritative.
model Item {
  id                String           @id @db.Uuid
  publicId          String           @unique @map("public_id") @db.Uuid
  slug              String           @db.VarChar(160)
  categoryId        String           @map("category_id") @db.Uuid
  lifecycleStatusId String           @map("lifecycle_status_id") @db.Uuid
  storageNodeId     String?          @map("storage_node_id") @db.Uuid
  displayName       String           @map("display_name")
  description       String?
  visibility        String           @default("authenticated") @db.VarChar(16)
  version           BigInt           @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime?        @map("archived_at") @db.Timestamptz(6)
  attributeValues   AttributeValue[] @relation("ItemAttributeValues")
  referencingValues AttributeValue[] @relation("ReferencedItemAttributeValues")
  search            ItemSearch?      @ignore
  tags              ItemTag[]
  category          Category         @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  lifecycleStatus   LifecycleStatus  @relation(fields: [lifecycleStatusId], references: [id], onUpdate: NoAction)
  mediaRelations    MediaRelation[]
  movements         Movement[]       @ignore
  uploadSessions    UploadSession[]

  @@index([categoryId, lifecycleStatusId, updatedAt(sort: Desc), id(sort: Desc)], map: "items_category_status_updated_idx", where: raw("(archived_at IS NULL)"))
  @@index([storageNodeId], map: "items_storage_node_idx", where: raw("(storage_node_id IS NOT NULL)"))
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "items_updated_idx", where: raw("(archived_at IS NULL)"))
  @@map("items")
}

model Tag {
  id             String    @id @db.Uuid
  name           String
  nameNormalized String    @unique @map("name_normalized")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  items          ItemTag[]

  @@index([nameNormalized], map: "tags_active_name_idx", where: raw("(archived_at IS NULL)"))
  @@map("tags")
}

model ItemTag {
  itemId    String   @map("item_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag       Tag      @relation(fields: [tagId], references: [id], onUpdate: NoAction)

  @@id([itemId, tagId])
  @@index([tagId, itemId], map: "item_tags_tag_idx")
  @@map("item_tags")
}

/// Kysely owns this synchronous read model; source transactions write through SearchProjectionPort.
model ItemSearch {
  itemId             String                  @id @map("item_id") @db.Uuid
  displayName        String                  @map("display_name")
  description        String?
  categoryId         String                  @map("category_id") @db.Uuid
  lifecycleStatusId  String                  @map("lifecycle_status_id") @db.Uuid
  pathText           String                  @default("") @map("path_text")
  publicPathText     String                  @default("") @map("public_path_text")
  searchVector       Unsupported("tsvector") @default(dbgenerated("''::tsvector")) @map("search_vector")
  publicSearchVector Unsupported("tsvector") @default(dbgenerated("''::tsvector")) @map("public_search_vector")
  attrs              Json                    @default("{}")
  publicAttrs        Json                    @default("{}") @map("public_attrs")
  visibility         String                  @db.VarChar(16)
  indexState         String                  @default("ready") @map("index_state") @db.VarChar(16)
  itemUpdatedAt      DateTime                @map("item_updated_at") @db.Timestamptz(6)
  indexedAt          DateTime                @default(now()) @map("indexed_at") @db.Timestamptz(6)
  category           Category                @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  item               Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lifecycleStatus    LifecycleStatus         @relation(fields: [lifecycleStatusId], references: [id], onUpdate: NoAction)

  @@index([searchVector], map: "item_search_vector_idx", type: Gin)
  @@index([publicSearchVector], map: "item_search_public_vector_idx", type: Gin)
  @@index([attrs(ops: JsonbPathOps)], type: Gin)
  @@index([publicAttrs(ops: JsonbPathOps)], type: Gin)
  @@index([itemUpdatedAt(sort: Desc), itemId(sort: Desc)], map: "item_search_updated_idx")
  @@index([categoryId, lifecycleStatusId, itemUpdatedAt(sort: Desc), itemId(sort: Desc)], map: "item_search_category_status_idx")
  @@map("item_search")
  @@ignore
}

/// Database checks and the append-only trigger remain authoritative; writes use MovementHistoryPort.
model Movement {
  id               String   @id @db.Uuid
  entityType       String   @map("entity_type") @db.VarChar(16)
  itemId           String?  @map("item_id") @db.Uuid
  storageNodeId    String?  @map("storage_node_id") @db.Uuid
  fromNodeId       String?  @map("from_node_id") @db.Uuid
  toNodeId         String?  @map("to_node_id") @db.Uuid
  fromPathSnapshot String?  @map("from_path_snapshot")
  toPathSnapshot   String?  @map("to_path_snapshot")
  actorUserId      String   @map("actor_user_id") @db.Uuid
  reason           String?  @db.VarChar(512)
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  correlationId    String   @map("correlation_id") @db.VarChar(128)
  actor            User     @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)
  item             Item?    @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([itemId, occurredAt(sort: Desc), id(sort: Desc)], map: "movements_item_idx", where: raw("(item_id IS NOT NULL)"))
  @@index([storageNodeId, occurredAt(sort: Desc), id(sort: Desc)], map: "movements_node_idx", where: raw("(storage_node_id IS NOT NULL)"))
  @@map("movements")
  @@ignore
}

/// Reservation uses Kysely; completion joins the source transaction through IdempotencyPort.
model IdempotencyRecord {
  id                   String    @id @db.Uuid
  actorId              String    @map("actor_id") @db.Uuid
  scope                String    @db.VarChar(96)
  keyHash              String    @map("key_hash") @db.Char(64)
  requestFingerprint   String    @map("request_fingerprint") @db.Char(64)
  state                String    @default("reserved") @db.VarChar(16)
  responseStatus       Int?      @map("response_status")
  responseBodyJson     Json?     @map("response_body_json")
  reservationTokenHash String    @map("reservation_token_hash") @db.Char(64)
  leaseExpiresAt       DateTime  @map("lease_expires_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  actor                User      @relation(fields: [actorId], references: [id], onUpdate: NoAction)

  @@unique([actorId, scope, keyHash], map: "idempotency_actor_scope_key")
  @@index([expiresAt], map: "idempotency_expiry_idx")
  @@index([leaseExpiresAt], map: "idempotency_reserved_lease_idx", where: raw("((state)::text = 'reserved'::text)"))
  @@map("idempotency_records")
  @@ignore
}

/// Media assets, relations and upload sessions are Prisma-owned; Kysely owns their DDL.
model MediaAsset {
  id               String          @id @db.Uuid
  storageKey       String          @unique @map("storage_key")
  originalFilename String          @map("original_filename")
  mimeType         String          @map("mime_type") @db.VarChar(128)
  byteSize         BigInt          @map("byte_size")
  width            Int?
  height           Int?
  checksumSha256   String          @map("checksum_sha256") @db.Char(64)
  processingState  String          @default("pending") @map("processing_state") @db.VarChar(16)
  sourceAssetId    String?         @map("source_asset_id") @db.Uuid
  metadataJson     Json            @default("{}") @map("metadata_json")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  deleteAfter      DateTime?       @map("delete_after") @db.Timestamptz(6)
  sourceAsset      MediaAsset?     @relation("MediaAssetVariants", fields: [sourceAssetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variants         MediaAsset[]    @relation("MediaAssetVariants")
  relations        MediaRelation[]

  @@index([checksumSha256], map: "media_assets_checksum_idx")
  @@index([deleteAfter], where: raw("(delete_after IS NOT NULL)"))
  @@index([processingState], where: raw("((processing_state)::text <> 'ready'::text)"))
  @@index([sourceAssetId], map: "media_assets_source_idx", where: raw("(source_asset_id IS NOT NULL)"))
  @@map("media_assets")
}

model MediaRelation {
  id            String     @id @db.Uuid
  assetId       String     @map("asset_id") @db.Uuid
  itemId        String?    @map("item_id") @db.Uuid
  storageNodeId String?    @map("storage_node_id") @db.Uuid
  role          String     @db.VarChar(20)
  position      Int        @default(0)
  altText       String?    @map("alt_text")
  visibility    String     @default("authenticated") @db.VarChar(16)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt    DateTime?  @map("archived_at") @db.Timestamptz(6)
  asset         MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item          Item?      @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([itemId, role], map: "media_relations_primary_item_idx", where: raw("(((role)::text = 'primary'::text) AND (archived_at IS NULL) AND (item_id IS NOT NULL))"))
  @@unique([storageNodeId, role], map: "media_relations_primary_node_idx", where: raw("(((role)::text = 'primary'::text) AND (archived_at IS NULL) AND (storage_node_id IS NOT NULL))"))
  @@unique([assetId, itemId], map: "media_relations_asset_item_idx", where: raw("((archived_at IS NULL) AND (item_id IS NOT NULL))"))
  @@unique([assetId, storageNodeId], map: "media_relations_asset_node_idx", where: raw("((archived_at IS NULL) AND (storage_node_id IS NOT NULL))"))
  @@unique([itemId, role, position], map: "media_relations_item_position_idx", where: raw("((archived_at IS NULL) AND (item_id IS NOT NULL))"))
  @@unique([storageNodeId, role, position], map: "media_relations_node_position_idx", where: raw("((archived_at IS NULL) AND (storage_node_id IS NOT NULL))"))
  @@index([assetId], map: "media_relations_asset_idx")
  @@index([itemId, role, position], map: "media_relations_item_idx", where: raw("(item_id IS NOT NULL)"))
  @@map("media_relations")
}

model UploadSession {
  id               String    @id @db.Uuid
  actorId          String    @map("actor_id") @db.Uuid
  itemId           String?   @map("item_id") @db.Uuid
  storageNodeId    String?   @map("storage_node_id") @db.Uuid
  declaredFilename String    @map("declared_filename")
  declaredMimeType String    @map("declared_mime_type") @db.VarChar(128)
  declaredByteSize BigInt    @map("declared_byte_size")
  tempStorageKey   String    @unique @map("temp_storage_key")
  receivedByteSize BigInt?   @map("received_byte_size")
  checksumSha256   String?   @map("checksum_sha256") @db.Char(64)
  state            String    @default("pending") @db.VarChar(16)
  failureCode      String?   @map("failure_code") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  finalizedAt      DateTime? @map("finalized_at") @db.Timestamptz(6)
  actor            User      @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item             Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actorId, createdAt(sort: Desc)], map: "upload_sessions_actor_idx")
  @@index([expiresAt], map: "upload_sessions_open_expiry_idx", where: raw("((state)::text = ANY ((ARRAY['pending'::character varying, 'received'::character varying])::text[]))"))
  @@map("upload_sessions")
}
