{
  "components": {
    "schemas": {
      "CurrentSessionResponseDto": {
        "properties": {
          "absoluteExpiresAt": { "format": "date-time", "type": "string" },
          "actor": { "$ref": "#/components/schemas/SessionActorDto" },
          "csrfToken": {
            "description": "Send as X-CSRF-Token on authenticated mutations.",
            "type": "string"
          },
          "idleExpiresAt": { "format": "date-time", "type": "string" },
          "sessionId": { "format": "uuid", "type": "string" }
        },
        "required": ["absoluteExpiresAt", "actor", "csrfToken", "idleExpiresAt", "sessionId"],
        "type": "object"
      },
      "CursorPageDto": {
        "properties": {
          "limit": { "example": 25, "maximum": 100, "minimum": 1, "type": "number" },
          "nextCursor": {
            "description": "Opaque cursor for the next page.",
            "example": "eyJpZCI6Ii4uLiJ9",
            "type": "string"
          }
        },
        "required": ["limit"],
        "type": "object"
      },
      "InvitationSummaryDto": {
        "properties": {
          "acceptedAt": { "format": "date-time", "nullable": true, "type": "string" },
          "email": { "format": "email", "type": "string" },
          "expiresAt": { "format": "date-time", "type": "string" },
          "id": { "format": "uuid", "type": "string" },
          "revokedAt": { "format": "date-time", "nullable": true, "type": "string" },
          "role": { "enum": ["admin", "editor", "owner", "viewer"], "type": "string" },
          "version": { "minimum": 1, "type": "number" }
        },
        "required": ["email", "expiresAt", "id", "role", "version"],
        "type": "object"
      },
      "IssuedInvitationDto": {
        "properties": {
          "acceptedAt": { "format": "date-time", "nullable": true, "type": "string" },
          "email": { "format": "email", "type": "string" },
          "expiresAt": { "format": "date-time", "type": "string" },
          "id": { "format": "uuid", "type": "string" },
          "revokedAt": { "format": "date-time", "nullable": true, "type": "string" },
          "role": { "enum": ["admin", "editor", "owner", "viewer"], "type": "string" },
          "token": {
            "description": "One-time token shown only when the invitation is issued.",
            "type": "string"
          },
          "version": { "minimum": 1, "type": "number" }
        },
        "required": ["email", "expiresAt", "id", "role", "token", "version"],
        "type": "object"
      },
      "ItemMutationRequestDto": {
        "properties": {
          "categoryId": {
            "example": "01JBM4V6M9Q5Q2HTY0FQVN3M2D",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "type": "string"
          },
          "displayName": {
            "example": "Cordless drill",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "expectedVersion": {
            "description": "Known aggregate version used for optimistic concurrency.",
            "example": 7,
            "minimum": 1,
            "type": "number"
          }
        },
        "required": ["displayName", "expectedVersion"],
        "type": "object"
      },
      "ItemPageResponseDto": {
        "properties": {
          "items": { "items": { "$ref": "#/components/schemas/ItemSummaryDto" }, "type": "array" },
          "page": { "$ref": "#/components/schemas/CursorPageDto" }
        },
        "required": ["items", "page"],
        "type": "object"
      },
      "ItemSummaryDto": {
        "properties": {
          "displayName": { "example": "Cordless drill", "type": "string" },
          "publicId": { "example": "itm_01JBM4V6M9Q5Q2HTY0FQVN3M2D", "type": "string" },
          "version": { "example": 8, "minimum": 1, "type": "number" }
        },
        "required": ["displayName", "publicId", "version"],
        "type": "object"
      },
      "ProblemDetailsDto": {
        "properties": {
          "code": { "example": "VALIDATION_FAILED", "type": "string" },
          "detail": { "example": "One or more fields are invalid.", "type": "string" },
          "fieldErrors": {
            "items": { "$ref": "#/components/schemas/ProblemFieldErrorDto" },
            "type": "array"
          },
          "requestId": {
            "example": "0198f40c-92f3-7a12-bc9a-653f97786c2b",
            "format": "uuid",
            "type": "string"
          },
          "status": { "example": 400, "maximum": 599, "minimum": 400, "type": "number" },
          "title": { "example": "Request validation failed", "type": "string" },
          "type": {
            "example": "https://inventory-atlas.local/problems/validation-failed",
            "type": "string"
          }
        },
        "required": ["code", "detail", "requestId", "status", "title", "type"],
        "type": "object"
      },
      "ProblemFieldErrorDto": {
        "properties": {
          "field": { "example": "displayName", "type": "string" },
          "messages": {
            "example": ["must contain at least 1 character"],
            "items": { "type": "string" },
            "type": "array"
          }
        },
        "required": ["field", "messages"],
        "type": "object"
      },
      "SessionActorDto": {
        "properties": {
          "displayName": { "type": "string" },
          "email": { "format": "email", "type": "string" },
          "id": { "format": "uuid", "type": "string" },
          "locale": { "enum": ["en", "uk"], "type": "string" },
          "permissions": {
            "items": {
              "enum": [
                "editItems",
                "manageAudit",
                "manageIntegrations",
                "manageJobs",
                "managePortability",
                "manageSchema",
                "manageSettings",
                "manageUsers",
                "moveInventory",
                "searchPrivateValues",
                "viewAuthenticatedFields",
                "viewPrivateFields",
                "viewPublicCards"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "role": { "enum": ["admin", "editor", "owner", "viewer"], "type": "string" }
        },
        "required": ["displayName", "email", "id", "locale", "permissions", "role"],
        "type": "object"
      },
      "SessionResponseDto": {
        "properties": {
          "absoluteExpiresAt": { "format": "date-time", "type": "string" },
          "actor": { "$ref": "#/components/schemas/SessionActorDto" },
          "csrfToken": {
            "description": "Send as X-CSRF-Token on authenticated mutations.",
            "type": "string"
          },
          "idleExpiresAt": { "format": "date-time", "type": "string" },
          "sessionId": { "format": "uuid", "type": "string" }
        },
        "required": ["absoluteExpiresAt", "actor", "csrfToken", "idleExpiresAt", "sessionId"],
        "type": "object"
      },
      "SessionSummaryDto": {
        "properties": {
          "absoluteExpiresAt": { "format": "date-time", "type": "string" },
          "createdAt": { "format": "date-time", "type": "string" },
          "current": { "type": "boolean" },
          "id": { "format": "uuid", "type": "string" },
          "idleExpiresAt": { "format": "date-time", "type": "string" },
          "lastSeenAt": { "format": "date-time", "type": "string" },
          "userAgentSummary": { "nullable": true, "type": "string" }
        },
        "required": [
          "absoluteExpiresAt",
          "createdAt",
          "current",
          "id",
          "idleExpiresAt",
          "lastSeenAt"
        ],
        "type": "object"
      },
      "UserSummaryDto": {
        "properties": {
          "archivedAt": { "format": "date-time", "nullable": true, "type": "string" },
          "displayName": { "type": "string" },
          "email": { "format": "email", "type": "string" },
          "id": { "format": "uuid", "type": "string" },
          "locale": { "enum": ["en", "uk"], "type": "string" },
          "role": { "enum": ["admin", "editor", "owner", "viewer"], "type": "string" },
          "status": { "enum": ["active", "disabled"], "type": "string" },
          "version": { "minimum": 1, "type": "number" }
        },
        "required": ["displayName", "email", "id", "locale", "role", "status", "version"],
        "type": "object"
      },
      "VersionConflictProblemDto": {
        "properties": {
          "code": { "example": "VALIDATION_FAILED", "type": "string" },
          "currentVersion": { "example": 8, "minimum": 1, "type": "number" },
          "detail": { "example": "One or more fields are invalid.", "type": "string" },
          "fieldErrors": {
            "items": { "$ref": "#/components/schemas/ProblemFieldErrorDto" },
            "type": "array"
          },
          "requestId": {
            "example": "0198f40c-92f3-7a12-bc9a-653f97786c2b",
            "format": "uuid",
            "type": "string"
          },
          "safeDiff": {
            "additionalProperties": true,
            "description": "Visibility-safe fields that changed since the submitted version.",
            "example": { "displayName": "Cordless drill (workshop)" },
            "type": "object"
          },
          "status": { "example": 400, "maximum": 599, "minimum": 400, "type": "number" },
          "title": { "example": "Request validation failed", "type": "string" },
          "type": {
            "example": "https://inventory-atlas.local/problems/validation-failed",
            "type": "string"
          }
        },
        "required": [
          "code",
          "currentVersion",
          "detail",
          "requestId",
          "safeDiff",
          "status",
          "title",
          "type"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "cookie": { "in": "cookie", "name": "inventory_atlas_session", "type": "apiKey" }
    }
  },
  "info": {
    "contact": {},
    "description": "The REST contract consumed by Inventory Atlas clients.",
